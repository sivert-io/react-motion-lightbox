# Rendered by the nginx image's entrypoint at start: only ${PORT} is filled in.
# Taken from gullberg.no's, without the parts for its 3D mark.

server {
  listen      ${PORT};
  listen      [::]:${PORT};
  server_name _;

  root  /usr/share/nginx/html;
  index index.html;

  # Behind Cloudflare Tunnel the peer is cloudflared, so the visitor's address
  # comes from CF-Connecting-IP. Only trusted from local and private addresses.
  set_real_ip_from  127.0.0.1;
  set_real_ip_from  10.0.0.0/8;
  set_real_ip_from  172.16.0.0/12;
  set_real_ip_from  192.168.0.0/16;
  real_ip_header    CF-Connecting-IP;
  real_ip_recursive on;

  # The tunnel doesn't compress on the way to the origin, so this does.
  gzip            on;
  gzip_vary       on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_proxied    any;
  gzip_types      text/plain text/css text/javascript text/xml
                  application/javascript application/json application/xml
                  image/svg+xml;

  include /etc/nginx/snippets/security-headers.conf;

  # `add_header` in a location replaces the inherited ones rather than adding
  # to them, so every location includes the headers snippet again.

  # Fingerprinted by Vite, and the fonts never change under the same name.
  location ~ ^/(assets|fonts)/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control 'public, max-age=31536000, immutable';
    access_log off;
  }

  # Named by their Unsplash id and width, and never edited in place.
  location /photos/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control 'public, max-age=2592000';
    access_log off;
  }

  location ~* \.(png|svg|txt|xml)$ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control 'public, max-age=3600, must-revalidate';
  }

  # One page. The HTML names the current asset hashes, so it's never cached.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control 'no-cache';
    try_files $uri $uri/ =404;
  }
}
