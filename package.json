{
  "name": "react-motion-lightbox",
  "version": "0.8.1",
  "description": "A React lightbox and image gallery that opens out of the photo you click and closes back into it: swipe, pinch and wheel zoom, thumbnails, video, focus-point crops. Built on Motion.",
  "license": "MIT",
  "author": "Sivert Gullberg Hansen <sivertgullberg@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sivert-io/react-motion-lightbox.git"
  },
  "homepage": "https://lightbox.gullberg.no",
  "bugs": "https://github.com/sivert-io/react-motion-lightbox/issues",
  "keywords": [
    "react",
    "lightbox",
    "react-lightbox",
    "gallery",
    "image-gallery",
    "photo-gallery",
    "image-viewer",
    "carousel",
    "slider",
    "zoom",
    "pinch-zoom",
    "swipe",
    "modal",
    "dialog",
    "thumbnails",
    "motion",
    "framer-motion",
    "animation",
    "typescript",
    "react-component"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "motion": ">=12",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
