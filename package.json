{
  "name": "react-motion-lightbox",
  "version": "0.1.0",
  "description": "A React lightbox that opens out of its thumbnail: a draggable track, pinch, wheel and double-tap zoom, and slots for your own video player, toolbar and title. Built on Motion.",
  "license": "MIT",
  "author": "Sivert Gullberg Hansen <sivertgullberg@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sivert-io/react-motion-lightbox.git"
  },
  "homepage": "https://github.com/sivert-io/react-motion-lightbox#readme",
  "bugs": "https://github.com/sivert-io/react-motion-lightbox/issues",
  "keywords": ["react", "lightbox", "gallery", "motion", "framer-motion", "zoom", "image-viewer"],
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "motion": ">=12",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
